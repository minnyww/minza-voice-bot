# Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID (optional, needed only if registering slash commands globally)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# TTS Provider: 'google' (fast ~240ms, reliable) or 'edge' (neural voice, auto-fallbacks to google)
TTS_PROVIDER=google

# Edge TTS Voice (used when TTS_PROVIDER=edge)
TTS_VOICE=th-TH-PremwadeeNeural

# Command prefix for text chat (default: !)
COMMAND_PREFIX=!
